def build_graph(edges, directed=False): 
    graph = {} 
     
    # Duyệt qua từng cạnh 
    for u, v in edges: 
        # Khởi tạo đỉnh u nếu chưa có 
        if u not in graph:
            graph[u] = []
         # Khởi tạo đỉnh v nếu chưa có 
        if v not in graph: 
            graph[v] = [] 
         
        # Thêm cạnh u → v 
        graph[u].append(v) 
         
        # Nếu vô hướng, thêm cạnh v → u 
        if not directed: 
            graph[v].append(u) 
     
    return graph

