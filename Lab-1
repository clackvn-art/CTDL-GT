#Bai 1
def snippet_1(n): 
    total = 0 # 1 phép gán 

    for i in range(n): # lặp n lần 
        total = total + 1 
    return total  # 1 phép trả về
# Độ phức tạp: O(n) 
# Giải thích: vòng for chạy n lần, mỗi lần chỉ có 1 phép gán/cộng.

def snippet_2(n): 
    count = 0 
    for i in range(n): 
        for j in range(n): 
            count += 1 
    return count
# Độ phức tạp: O(n^2) 
# Giải thích: có 2 vòng for lồng nhau, mỗi vòng chạy n lần → tổng n * n = n^2 bước.

def snippet_3(n): 
    steps = 0 
    while n > 0: 
        n = n // 2 
        steps += 1 
    return steps
# Độ phức tạp: O(log n) 
# Giải thích: mỗi vòng while chia n cho 2, nên số vòng ≈ số lần chia đôi n về 1 là log2(n).

def constant_work(): 
    x = 1 
    y = 2 
    z = x + y 
    return z 
 
def snippet_4(n):
    for i in range(n): 
        constant_work()
# Độ phức tạp: O(n) 
# Giải thích: vòng for chạy n lần, mỗi lần gọi hàm O(1), nên tổng thời gian tỉ lệ tuyến tính 
với n.

#Bai 2
def snippet_5(n): 
    total = 0 
    for i in range(n): 
        for j in range(i): 
            total += 1 
    return total
# Độ phức tạp: O(n^2) 
# Giải thích: có 2 vòng for lồng nhau, mỗi vòng chạy n lần → tổng n * n = n^2 bước.

def snippet_6(n): 
    k = 1 
    total = 0 
    while k < n: 
        for i in range(n): 
            total += 1 
        k = k * 2 
    return total
# Độ phức tạp: O(n log n)
# Giải thích: vòng while chạy log2(n) lần, và mỗi lần vòng for chạy n bước → tổng n * log2(n) bước.

def snippet_7(arr): 
    count = 0 
    for x in arr: 
        if x in arr:  # kiểm tra x có trong arr 
            count += 1 
    return count
# Độ phức tạp: O(n^2) 
# Giải thích: Mỗi lần phép x in arr phải duyệt cả list (tốn O(n)), mỗi vòng chạy n lần → tổng n * n = n^2 bước.

def snippet_8(arr): 
    s = set(arr) 
    count = 0 
    for x in arr: 
        if x in s: 
            count += 1 
    return count
# Độ phức tạp: O(n) 
# Giải thích: việc chuyển đổi mảng thành tập hợp mất thời gian O(n), và việc kiểm tra sự tồn tại của phần tử trong tập hợp mất thời gian O(1), tổng cộng là O(n).

#Bai 3
def two_sum_quadratic(arr, target): 
    n = len(arr) 
    for i in range(n): 
        for j in range(i + 1, n): 
            if arr[i] + arr[j] == target: 
                return (i, j) 
    return None

#Bước 1: Phân tích O(n^2)
# Độ phức tạp: O(n^2)
# Giải thích: Có 2 vòng for lồng nhau, mỗi vòng chạy n lần → tổng n * n = n^2 bước.

#Bước 2: Viết phiên bản O(n)
def two_sum_linear(arr, target): 
    seen = {}  # Tạo dict
    for i, num in enumerate(arr): 
        complement = target - arr[i]  
        if complement in seen:  # Kiểm tra  
            return (seen[complement], i)  # Trả về chỉ số
        seen[num] = i  # Lưu số hiện tại vào dict
    return None

#Bước 3: So sánh thời gian chạy (tự chọn)
import time
import random
# Tạo mảng ngẫu nhiên
size = 100000
arr = [random.randint(1, 100) for _ in range(size)]
target = random.randint(1, 200)
# Đo thời gian chạy của phiên bản O(n^2)
start_time = time.time()
two_sum_quadratic(arr, target)
end_time = time.time()
print("Thời gian chạy O(n^2):", end_time - start_time, "giây")
# Đo thời gian chạy của phiên bản O(n)
start_time = time.time()
two_sum_linear(arr, target)
end_time = time.time()
print("Thời gian chạy O(n):", end_time - start_time, "giây")
