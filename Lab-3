#Lab 3_bai 3
def subset_sum_basic(nums, target): 
    """ 
    Subset Sum cơ bản - KHÔNG có pruning 
    """ 
    result = [] 
     
    def backtrack(start, path, current_sum): 
        # TODO: Base case - nếu current_sum == target 
        if current_sum == target:
            result.append(path.copy())
            return
         
        if current_sum > target: 
            return  # Dừng ngay, không đệ quy tiếp
        

        # TODO: Thử thêm các số từ vị trí start 
        for i in range(start, len(nums)): 

            nums.sort()  # Sắp xếp tăng dần 
            if current_sum + nums[i] > target: 
                break  # Các số sau còn lớn hơn → break luôn

            if i > start and nums[i] == nums[i-1]: 
                continue  # Bỏ qua số trùng

            remaining_sum = sum(nums[i:]) 
            if current_sum + remaining_sum < target: 
                break  # Cộng hết cũng không đủ

            # CHOOSE 
            path.append(nums[i]) 
             
            # EXPLORE 
            backtrack(i + 1, path, current_sum + nums[i]) 
             
            # UNCHOOSE 
            path.pop() 
     
    backtrack(0, [], 0) 
    return result

class Counter: 
    """Class để đếm số lần gọi hàm""" 
    def __init__(self): 
        self.total_calls = 0 
        self.solutions = 0 
     
    def report(self): 
        print(f"Tổng số lần gọi: {self.total_calls}")
        print(f"Số giải pháp tìm được: {self.solutions}")

def compare_subset_sum(nums = list(range(1, 20)), target = 50):
    print("=== Subset Sum Basic (No Pruning) ===")
    counter_basic = Counter()
    result_basic = []
    
    def backtrack_basic(start, path, current_sum):
        counter_basic.total_calls += 1
        
        if current_sum == target:
            result_basic.append(path.copy())
            counter_basic.solutions += 1
            return
        
        if current_sum > target:
            return
        
        for i in range(start, len(nums)):
            # CHOOSE
            path.append(nums[i])
            
            # EXPLORE
            backtrack_basic(i + 1, path, current_sum + nums[i])
            
            # UNCHOOSE
            path.pop()
    
    backtrack_basic(0, [], 0)
    counter_basic.report()
    print(f"Giải pháp: {result_basic}")
compare_subset_sum()
