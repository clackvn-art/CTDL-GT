def group_coupon_anagrams(codes):
    # Nhóm các mã coupon là anagram của nhau.
    groups = {}

    for code in codes:
        # Tạo key bằng cách sắp xếp ký tự
        key = "".join(sorted(code))

        if key not in groups:
            groups[key] = []

        groups[key].append(code)

    return list(groups.values())

