def promo_knapsack(price, bonus_score, B):
    # price        : trọng lượng
    # bonus_score  : giá trị
    # B            : ngân sách

    n = len(price)

    dp = [[0]*(B+1) for _ in range(n+1)]

    for i in range(1, n+1):

        for w in range(B+1):

            # Không chọn sản phẩm
            dp[i][w] = dp[i-1][w]

            # Nếu đủ ngân sách
            if price[i-1] <= w:

                dp[i][w] = max(
                    dp[i][w],
                    bonus_score[i-1] +
                    dp[i-1][w-price[i-1]]
                )
    # Truy vết
    selected = []

    w = B

    for i in range(n,0,-1):

        if dp[i][w] != dp[i-1][w]:

            selected.append(i-1)

            w -= price[i-1]

    selected.reverse()

    return dp[n][B], selected

