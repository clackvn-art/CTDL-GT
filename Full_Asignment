# promo opt
def fib_memo(n):
    memo = {}

    def dp(x):
        if x in memo:
            return memo[x]

        if x <= 1:
            return x

        memo[x] = dp(x - 1) + dp(x - 2)
        return memo[x]

    return dp(n)

def climb_stairs(n):
    # Trả về số cách leo n bậc.

    if n <= 2:
        return n

    dp = [0] * (n + 1)

    dp[1] = 1
    dp[2] = 2

    for i in range(3, n + 1):
        dp[i] = dp[i - 1] + dp[i - 2]

    return dp[n]

def demo_dp_basics():

