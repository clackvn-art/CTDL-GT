    ]

    # Danh sách đường truyền được chọn. 
    vertices = ['WH1', 'WH2', 'HCM', 'HN', 'DN']

    # Tổng chi phí lắp đặt.
    mst_edges, total_cost = kruskal_mst(vertices, edges)
