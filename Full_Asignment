def combo_knapsack_1d(prices, scores, B):
    n = len(prices)

    # dp[b] = điểm tối đa với ngân sách b
    dp = [0] * (B + 1)

    for i in range(n):

        # Duyệt NGƯỢC
        for b in range(B, prices[i] - 1, -1):

            dp[b] = max(
                dp[b],
                dp[b - prices[i]] + scores[i]
            )

    return dp[B]

def demo_combo_knapsack_1d():

    print("===== DEMO KNAPSACK 1D =====")

    products = [
        "Laptop",
