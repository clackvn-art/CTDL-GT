def find_content_children(greed, cookies): 
    """ 
    Assign Cookies - LeetCode 455 
    Chiến lược: Sort cả 2 mảng + Two Pointers 
    """ 
    # TODO: Sort cả greed và cookies 
    greed.sort() 
    cookies.sort() 
    
    # TODO: Dùng 2 con trỏ duyệt 
    i, j = 0, 0 
    content_children = 0 
    
    while i < len(greed) and j < len(cookies): 
        if cookies[j] >= greed[i]: 
            content_children += 1 
            i += 1 
        j += 1 
    
    # TODO: Trả về số trẻ đã thỏa mãn 
    return content_children

def manhattan_distance(workers, bikes): 
    return abs(workers[0] - bikes[0]) + abs(workers[1] - bikes[1]) 

def assign_bikes(workers, bikes):

    distances = []

    # Tính tất cả khoảng cách
    for w in range(len(workers)):
        for b in range(len(bikes)):

            dist = manhattan_distance(
                workers[w],
                bikes[b]
            )

            distances.append((dist, w, b))

    # Sort theo khoảng cách tăng dần
    distances.sort()

    assigned_workers = set()
    assigned_bikes = set()

    result = [-1] * len(workers)

    # Greedy chọn cặp gần nhất
    for dist, w, b in distances:

        if w not in assigned_workers and b not in assigned_bikes:

            result[w] = b

            assigned_workers.add(w)
            assigned_bikes.add(b)

    return result

