def coin_change_dp(amount, coins): 
    """ 
    Coin Change với Dynamic Programming 
    Luôn cho lời giải tối ưu 
     
    dp[i] = số xu ít nhất để đổi số tiền i 
    dp[i] = min(dp[i - coin] + 1) với mọi coin <= i 
    """ 
    # TODO: Khởi tạo dp array 
    dp = [float('inf')] * (amount + 1) 
    dp[0] = 0  # Base case 
     
    # TODO: Tính dp[i] cho i từ 1 đến amount 
    for i in range(1, amount + 1): 
        for coin in coins: 
            if coin <= i: 
                dp[i] = min(dp[i], dp[i - coin] + 1) 
     
    # TODO: Trả về kết quả 
    if dp[amount] == float('inf'): 
        return -1 
    return dp[amount]

def coin_change_greedy(amount, coins): 
    """ 
    Coin Change với Greedy 
    Không đảm bảo tối ưu nếu hệ coin không chuẩn 
    """ 
    coins.sort(reverse=True)  # Sort coins giảm dần 
    count = 0 
    detail = []  # Chi tiết số lượng mỗi coin dùng 
     
    for coin in coins: 
        if amount <= 0: 
            break 
        num = amount // coin  # Số coin loại này cần dùng 
        if num > 0: 
            count += num 
            amount -= num * coin 
            detail.append((coin, num))  # Lưu chi tiết 
     
    if amount > 0:  # Nếu còn dư tiền mà không đổi được 
        return -1, detail 
    return count, detail

