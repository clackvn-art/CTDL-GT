def min_intervals_remove(intervals): 
    """ 
    Tìm số khoảng thời gian ít nhất cần xóa 
    để còn lại không chồng lấp 
     
    Chiến lược: Tìm số khoảng tối đa giữ lại (Activity Selection) 
    → Số xóa = tổng - số giữ lại 
    """ 
    if not intervals: 
        return 0 
     
    # Tái sử dụng hàm activity_selection 
    max_keep = activity_selection(intervals) 
     
    # Số cần xóa 
    num_remove = len(intervals) - len(max_keep) 
     
    return num_remove 
 
 
